#!/usr/bin/env python3
"""Check an exported index; never add, stash, commit, or rewrite the real index."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

os.environ["GIT_OPTIONAL_LOCKS"] = "0"
root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
os.chdir(root)
if subprocess.run(["git", "diff", "--quiet"]).returncode:
    print("pre-commit: partial staging/unstaged changes to tracked files are rejected", file=sys.stderr)
    sys.exit(1)
entries = subprocess.check_output(["git", "ls-files", "--stage", "-z"]).split(b"\0")
entries = [entry for entry in entries if entry]
if not entries:
    print("pre-commit: empty index; no staged project to validate", file=sys.stderr)
    sys.exit(3)
for entry in entries:
    metadata, _path = entry.split(b"\t", 1)
    mode, _oid, stage = metadata.split()
    if mode not in [b"100644", b"100755"] or stage != b"0":
        print("pre-commit: unsupported staged symlink/submodule/conflict", file=sys.stderr)
        sys.exit(1)
with tempfile.TemporaryDirectory(prefix="atheum-index-") as directory:
    snapshot = Path(directory)
    subprocess.run(["git", "checkout-index", "--all", "--prefix=" + str(snapshot) + "/"], check=True)
    for name in ["deps", ".cache", "artifacts"]:
        source = root / name
        if source.exists() and not (snapshot / name).exists():
            (snapshot / name).symlink_to(source, target_is_directory=True)
    check = snapshot / "scripts" / "check"
    if not check.is_file():
        print("pre-commit: staged scripts/check missing", file=sys.stderr)
        sys.exit(3)
    result = subprocess.run([str(check), "precommit"], cwd=snapshot)
    sys.exit(result.returncode)
