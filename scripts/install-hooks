#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
common=$(git rev-parse --git-common-dir)
common=$(cd "$common" && pwd -P)
hooks="$common/codex-hooks"
existing=$(git config --get core.hooksPath || true)
if [ -n "$existing" ] && [ "$existing" != .githooks ] && [ "$existing" != "$hooks" ]; then
  echo 'BLOCKED: existing hooksPath differs; preserve it and reconcile manually' >&2
  exit 1
fi
# Inspect every registered checkout; only query worktree-specific configuration
# when Git enables it. Missing config is distinct from a failed config read.
if worktree_config=$(git config --type=bool --get extensions.worktreeConfig); then
  :
else
  result=$?
  if [ "$result" -ne 1 ]; then
    echo 'BLOCKED: worktree configuration cannot be inspected' >&2
    exit 1
  fi
  worktree_config=false
fi
python3 - "$hooks" "$worktree_config" <<'PY'
import os
import subprocess
import sys

hooks, enabled = sys.argv[1:]
common = os.path.realpath(os.path.dirname(hooks))
records = subprocess.check_output(["git", "worktree", "list", "--porcelain", "-z"])
for record in records.split(b"\0"):
    if not record.startswith(b"worktree "):
        continue
    path = os.fsdecode(record[len(b"worktree "):])
    available = subprocess.run(
        ["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    if available.returncode:
        sys.exit("BLOCKED: registered worktree cannot be inspected")
    actual = os.path.realpath(os.fsdecode(available.stdout.removesuffix(b"\n")))
    if actual != common:
        sys.exit("BLOCKED: registered worktree belongs to a different repository")
    effective = subprocess.run(
        ["git", "-C", path, "config", "--null", "--show-origin", "--get-all", "core.hooksPath"],
        capture_output=True,
    )
    if effective.returncode not in (0, 1):
        sys.exit("BLOCKED: effective hook configuration cannot be inspected")
    fields = effective.stdout.split(b"\0")[:-1]
    if len(fields) % 2:
        sys.exit("BLOCKED: malformed effective hook configuration")
    for origin, value in zip(fields[::2], fields[1::2]):
        value = os.fsdecode(value)
        source = os.fsdecode(origin)
        shared = source.startswith("file:") and os.path.realpath(
            os.path.join(path, source[5:])
        ) == os.path.join(common, "config")
        if value != hooks and not (shared and value == ".githooks"):
            sys.exit("BLOCKED: effective worktree hooksPath override exists; reconcile manually")
    if enabled != "true":
        continue
    result = subprocess.run(
        ["git", "-C", path, "config", "--worktree", "--get", "core.hooksPath"],
        capture_output=True,
    )
    if result.returncode == 0:
        # Strip only Git's record delimiter, preserving whitespace in paths.
        override = os.fsdecode(result.stdout.removesuffix(b"\n"))
        if override != hooks:
            sys.exit("BLOCKED: a worktree hooksPath override exists; reconcile manually")
    elif result.returncode != 1:
        sys.exit("BLOCKED: worktree hook configuration cannot be inspected")
PY
if [ -z "$existing" ]; then
  for hook in "$common"/hooks/*; do
    case "$hook" in *.sample) continue ;; esac
    if [ -f "$hook" ] && [ -x "$hook" ]; then
      echo 'BLOCKED: active default hook exists; preserve it and reconcile manually' >&2
      exit 1
    fi
  done
fi
if [ -L "$hooks" ]; then
  echo 'BLOCKED: shared hook directory is a symlink; reconcile manually' >&2
  exit 1
fi
mkdir -p "$hooks"
for name in review-gate pre-push pre-commit; do
  if [ -d "$hooks/$name" ]; then
    echo 'BLOCKED: installed hook destination is a directory; reconcile manually' >&2
    exit 1
  fi
done
pending=$(mktemp -d "$hooks/.install.XXXXXX")
trap 'rm -rf "$pending"' EXIT HUP INT TERM
cp ./scripts/review-gate "$pending/review-gate"
cat > "$pending/pre-push" <<'HOOK'
#!/bin/sh
set -eu
runner=$(cd "$(dirname "$0")" && pwd -P)/review-gate
cd "$(git rev-parse --show-toplevel)"
exec "$runner" push "$@"
HOOK
cat > "$pending/pre-commit" <<'HOOK'
#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
[ -x ./.githooks/pre-commit ] || {
  echo 'BLOCKED: this worktree lacks its project pre-commit checks' >&2
  exit 1
}
exec ./.githooks/pre-commit "$@"
HOOK
chmod +x "$pending/review-gate" "$pending/pre-push" "$pending/pre-commit"
# Each published executable is complete before an atomic same-directory rename.
for name in review-gate pre-push pre-commit; do
  mv -f "$pending/$name" "$hooks/$name"
done
git config --local core.hooksPath "$hooks"
echo 'Installed shared push gate and project pre-commit dispatcher.'
