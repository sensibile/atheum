#!/usr/bin/env python3
"""Synthetic integration tests. These fixtures are NOT product security reviews."""

import copy
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

if sys.flags.optimize:
    sys.exit("BLOCKED: tests require Python assertions; disable optimization")

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location("gate", root / "scripts/review-gate")
# Extensionless executable needs an explicit source loader.
from importlib.machinery import SourceFileLoader

spec = importlib.util.spec_from_loader(
    "gate", SourceFileLoader("gate", str(root / "scripts/review-gate"))
)
gate = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gate)
# Policy is deterministic over immutable supplied observations, with no repository.
base_sha, head_sha, other_sha = "a" * 40, "b" * 40, "c" * 40
core_plan = {
    "version": 3,
    "target_ref": "refs/heads/main",
    "remote_main": base_sha,
    "ref": "refs/heads/feature",
    "scan_base": base_sha,
    "head": head_sha,
    "remote_old": base_sha,
}
core_snapshot = gate.PlanSnapshot(
    (
        (head_sha, head_sha),
        (base_sha, base_sha),
        (base_sha, base_sha),
        (base_sha, base_sha),
    ),
    (("refs/heads/main", base_sha), ("refs/heads/feature", base_sha)),
    base_sha,
    (head_sha,),
    (base_sha,),
)
assert gate.plan_policy_errors(core_plan, core_snapshot) == ()
assert "not a commit" in gate.plan_policy_errors(
    core_plan, core_snapshot._replace(resolved_commits=())
)
assert (
    "destination branch changed; prepare and review again"
    in gate.plan_policy_errors({**core_plan, "remote_old": other_sha}, core_snapshot)
)
for snapshot in (
    core_snapshot._replace(commits=()),
    core_snapshot._replace(commits=(other_sha, head_sha)),
    core_snapshot._replace(parents=(base_sha, other_sha)),
):
    assert gate.plan_policy_errors(core_plan, snapshot)
new_plan = {**core_plan, "remote_old": "0" * 40, "remote_main": base_sha}
new_snapshot = core_snapshot._replace(
    advertised_refs=(("refs/heads/main", base_sha),),
    merge_base=base_sha,
    resolved_commits=core_snapshot.resolved_commits[:3],
)
assert gate.plan_policy_errors(new_plan, new_snapshot) == ()
for snapshot in (
    new_snapshot._replace(advertised_refs=(("refs/heads/main", other_sha),)),
    new_snapshot._replace(
        advertised_refs=(("refs/heads/main", base_sha), (new_plan["ref"], other_sha))
    ),
    new_snapshot._replace(merge_base=other_sha),
):
    assert gate.plan_policy_errors(new_plan, snapshot)
# Existing branches must still bind the live target and full PR merge-base.
assert gate.plan_policy_errors({**core_plan, "version": 2}, core_snapshot)
assert gate.plan_policy_errors({**core_plan, "scan_base": head_sha}, core_snapshot)
assert gate.plan_policy_errors(
    core_plan,
    core_snapshot._replace(
        advertised_refs=(
            ("refs/heads/main", other_sha),
            ("refs/heads/feature", base_sha),
        )
    ),
)
assert gate.plan_policy_errors(core_plan, core_snapshot) == ()
plugin = gate.plugin().parent.parent
example = plugin / "examples/completed-scan"
for left, right in (
    (
        "ssh://git@example.invalid:2222/owner/repo.git",
        "ssh://git@example.invalid:3333/owner/repo.git",
    ),
    ("git@example.invalid:owner/repo.git", "ssh://git@example.invalid/owner/repo.git"),
    ("https://example.invalid/repo", "https://example.invalid/repo.git"),
):
    assert gate.repository_location(left) != gate.repository_location(right)
for remote_url in (
    "ssh://git@example.invalid/repo?different=1",
    "git://example.invalid/repo#different",
    "ssh://git@example.invalid/repo?",
    "git://example.invalid/repo#",
):
    try:
        gate.repository_location(remote_url)
        raise AssertionError("ambiguous URL accepted")
    except ValueError as error:
        assert "query or fragment" in str(error)
assert gate.repository_location(
    "https://example.invalid/owner%2Frepo"
) != gate.repository_location("https://example.invalid/owner/repo")
assert gate.repository_location(
    "git@github.com:sensibile/acropolis.git"
) == gate.repository_location("https://github.com/sensibile/acropolis.git")
for remote_url in (
    "evil::payload",
    "ext::payload",
    "evil://host/repo",
    "ftp://host/repo",
    "--upload-pack=evil:x",
):
    try:
        gate.safe_push_url(remote_url)
        raise AssertionError("remote helper URL accepted")
    except ValueError as error:
        assert any(
            reason in str(error)
            for reason in ("remote-helper", "unsupported", "option-like")
        )
for control in ("\r", "\n", "\t"):
    try:
        gate.safe_push_url("file:///fixture/repository" + control)
        raise AssertionError("control-character URL accepted")
    except ValueError as error:
        assert "control-character" in str(error)
count = 0
with tempfile.TemporaryDirectory(prefix="push-gate-test-") as tmp:
    temp = Path(tmp).resolve()
    repo = temp / "repo\n"
    repo.mkdir()
    env = os.environ.copy()
    for key in subprocess.check_output(
        ["git", "rev-parse", "--local-env-vars"], text=True
    ).splitlines():
        env.pop(key, None)
    env.pop("CODEX_SECURITY_PLUGIN_DIR", None)
    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull)

    def run(args, success=True, stdin=None, cwd=repo):
        global count
        result = subprocess.run(
            args, cwd=cwd, env=env, text=True, input=stdin, capture_output=True
        )
        assert (result.returncode == 0) == success, (args, result.stdout, result.stderr)
        count += 1
        return result.stdout.strip()

    run(["git", "init", "-b", "main"])
    run(["git", "config", "user.name", "Synthetic Test"])
    run(["git", "config", "user.email", "test@example.invalid"])
    (repo / "scripts").mkdir()
    shutil.copy2(root / "scripts/review-gate", repo / "scripts/review-gate")
    shutil.copy2(root / "scripts/prepare-push", repo / "scripts/prepare-push")
    (repo / ".githooks").mkdir()
    shutil.copy2(root / ".githooks/pre-push", repo / ".githooks/pre-push")
    run(["git", "add", "."])
    run(["git", "commit", "-m", "test: baseline"])
    baseline = run(["git", "rev-parse", "HEAD"])
    remote = temp / "remote.git"
    run(["git", "init", "--bare", str(remote)])
    remote_url = "file://localhost" + str(remote)
    run(["git", "remote", "add", "origin", remote_url])
    run(["git", "push", "origin", "main"])
    run(["git", "checkout", "-b", "feature"])
    (repo / "file").write_text("feature\n")
    run(["git", "add", "."])
    run(["git", "commit", "-m", "test: feature"])
    head = run(["git", "rev-parse", "HEAD"])
    run(["git", "config", "core.hooksPath", ".githooks"])
    run(["git", "config", "codex.securityPluginDir", str(plugin)])
    run(["./scripts/prepare-push", "origin", "feature"])
    folder = Path(run(["git", "rev-parse", "--git-common-dir"])) / "push-reviews"
    planpath = next((repo / folder / "plans").glob("*.json"))
    plan = json.loads(planpath.read_text())
    assert plan["scan_base"] == baseline and plan["remote_old"] == "0" * len(head)
    run(["git", "push", "origin", "feature"], False)
    agent = temp / "agent.json"
    agentdata = {
        "kind": "agent",
        "verdict": "pass",
        "review_mode": "self",
        "independent": False,
        "reviewed_base": baseline,
        "reviewed_head": head,
        "reviewer": "synthetic fixture",
        "summary": "Not an actual review",
        "blocking_findings": [],
    }
    agent.write_text(json.dumps(agentdata))
    scan = temp / "scan"
    scan.mkdir()
    manifest = json.loads((example / "scan-manifest.json").read_text())
    coverage = json.loads((example / "coverage.json").read_text())
    findings = json.loads((example / "findings.json").read_text())
    manifest["scan"]["target"] = {
        "kind": "git_diff",
        "targetId": "synthetic-test",
        "displayName": "fixture",
        "remote": remote_url,
        "baseRevision": baseline,
        "headRevision": head,
        "snapshotDigest": "codex-security-snapshot/v1:sha256:" + "a" * 64,
    }
    manifest["scan"].pop("sealedAt")
    manifest["scan"].pop("artifacts")
    coverage["mode"] = "diff"
    coverage["inventoryStrategy"] = "diff"
    coverage["surfaces"][0]["disposition"] = "no_issue_found"
    findings["findings"] = []

    def seal(m=manifest, c=coverage, f=findings):
        for name, value in [
            ("scan-manifest.json", m),
            ("coverage.json", c),
            ("findings.json", f),
        ]:
            (scan / name).write_text(json.dumps(value))
        run(
            [
                sys.executable,
                str(plugin / "scripts/finalize_scan_contract.py"),
                "--scan-dir",
                str(scan),
            ]
        )

    record = ["./scripts/review-gate", "record", str(planpath), str(scan), str(agent)]
    seal()
    run(record)
    # Self-review passes actual registration and push validation without claiming independence.
    run(["git", "push", "--dry-run", "origin", "feature"])
    for mode, independent, accepted in (
        (None, True, True), ("independent", True, True),
        (None, False, False), ("self", True, False),
        ("independent", False, False), ("other", False, False),
        ("self", None, False), ("self", 0, False), ("self", "false", False),
    ):
        variant = {**agentdata, "independent": independent}
        if mode is None:
            variant.pop("review_mode")
        else:
            variant["review_mode"] = mode
        agent.write_text(json.dumps(variant))
        run(record, accepted)
    agent.write_text(json.dumps(agentdata))
    run(record)
    # Both attestation fields must contain real text, not arbitrary truthy JSON.
    before_attestation = (repo / folder / (gate.identity(plan) + ".json")).read_bytes()
    for field in ("reviewer", "summary"):
        for value in (
            " \t\n",
            {"text": "truthy object"},
            ["truthy list"],
            7,
            True,
            None,
            "",
        ):
            agent.write_text(json.dumps({**agentdata, field: value}))
            run(record, False)
            assert (
                repo / folder / (gate.identity(plan) + ".json")
            ).read_bytes() == before_attestation
    agent.write_text(json.dumps(agentdata))
    # Relative installation paths must not select different worktree validators.
    run(["git", "config", "codex.securityPluginDir", "."])
    run(record, False)
    run(["git", "config", "codex.securityPluginDir", str(plugin)])
    env["CODEX_SECURITY_PLUGIN_DIR"] = "."
    run(record, False)
    env.pop("CODEX_SECURITY_PLUGIN_DIR")
    canonical_alias = temp / "plugin-alias"
    canonical_alias.symlink_to(plugin, target_is_directory=True)
    run(["git", "config", "codex.securityPluginDir", str(canonical_alias)])
    run(record)
    run(["git", "config", "codex.securityPluginDir", str(plugin)])
    # A forged baseline must fail registration and actual pre-push, even with
    # otherwise valid sealed scan and review artifacts.
    original_plan = planpath.read_text()
    planpath.write_text(json.dumps({**plan, "remote_main": head, "scan_base": head}))
    run(record, False)
    planpath.write_text(original_plan)
    receiptpath = repo / folder / (gate.identity(plan) + ".json")
    original_receipt = receiptpath.read_text()
    receipt = json.loads(original_receipt)
    receipt["plan"].update(remote_main=head, scan_base=head)
    receiptpath.write_text(json.dumps(receipt))
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    receiptpath.write_text(original_receipt)
    # A real baseline change after registration invalidates the receipt.
    run(["git", "--git-dir", str(remote), "fetch", str(repo), "feature"])
    run(["git", "--git-dir", str(remote), "update-ref", "refs/heads/main", head])
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    run(["git", "--git-dir", str(remote), "update-ref", "refs/heads/main", baseline])
    # Local destination forms normalize to the canonical producer's file URL.
    for declared in (str(remote), "file://" + str(remote)):
        assert gate.repository_location(declared) == gate.repository_location(
            remote_url
        )
        local_plan = {**plan, "url": declared}
        local_planpath = temp / "local-plan.json"
        local_planpath.write_text(json.dumps(local_plan))
        run(
            [
                "./scripts/review-gate",
                "record",
                str(local_planpath),
                str(scan),
                str(agent),
            ]
        )
    # Desktop producer's actual contract omits the optional remote field.
    without_remote = copy.deepcopy(manifest)
    without_remote["scan"]["target"].pop("remote")
    seal(without_remote)
    run(record)
    run(["git", "push", "--dry-run", "origin", "feature"])
    # Even a valid receipt cannot authorize the first of multiple destinations.
    mirror = temp / "mirror.git"
    run(["git", "init", "--bare", str(mirror)])
    run(["git", "config", "--add", "remote.origin.pushurl", remote_url])
    run(
        [
            "git",
            "config",
            "--add",
            "remote.origin.pushurl",
            "file://localhost" + str(mirror),
        ]
    )
    run(["git", "push", "origin", "feature"], False)
    assert not run(["git", "ls-remote", remote_url, "refs/heads/feature"])
    assert not run(["git", "ls-remote", str(mirror)])
    run(["git", "config", "--unset-all", "remote.origin.pushurl"])
    run(["git", "replace", baseline, head])
    run(record, False)
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    run(["git", "replace", "-d", baseline])
    other_repo = copy.deepcopy(manifest)
    other_repo["scan"]["target"]["remote"] = "https://example.invalid/other.git"
    seal(other_repo)
    run(record, False)
    assert gate.repository_location(
        "git@github.com:sensibile/axiom.git"
    ) == gate.repository_location("https://github.com/sensibile/axiom.git")
    seal()
    run(record)
    # Full git push exercises the actual Git hook stdin protocol.
    run(["git", "push", "--dry-run", "origin", "feature"])
    bad = copy.deepcopy(manifest)
    bad["scan"]["target"]["headRevision"] = baseline
    seal(bad)
    run(record, False)
    bad = copy.deepcopy(coverage)
    bad["completeness"] = "partial"
    seal(c=bad)
    run(record, False)
    reported = copy.deepcopy(coverage)
    reported["surfaces"][0]["disposition"] = "reported"
    seal(c=reported)
    run(record, False)
    seal()
    bad = json.loads((scan / "scan-manifest.json").read_text())
    bad["scan"]["status"] = "failed"
    (scan / "scan-manifest.json").write_text(json.dumps(bad))
    run(record, False)
    # Official sealed fixture with a finding: validator succeeds but gate blocks.
    original = json.loads((example / "findings.json").read_text())
    badcov = copy.deepcopy(coverage)
    badcov["surfaces"][0]["disposition"] = "reported"
    seal(c=badcov, f=original)
    run(record, False)
    seal()
    run(record)
    (scan / "coverage.json").write_text("{}")
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    seal()
    run(record)
    agent.write_text(json.dumps({**agentdata, "summary": "changed"}))
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    agent.write_text(json.dumps(agentdata))
    run(record)
    run(["git", "push", "--dry-run", "origin", "feature"])
    # All receipts can be individually valid while one push changes another
    # receipt's PR target. Exercise the real Git hook and local bare remote.
    feature_receipt = receiptpath.read_bytes()
    run(["git", "--git-dir", str(remote), "update-ref", "refs/heads/release", baseline])
    for branch, target in (
        ("release", "main"),
        ("unrelated", "main"),
        ("feature", "release"),
    ):
        if branch != "feature":
            run(["git", "branch", branch, head])
        run(["./scripts/prepare-push", "origin", branch, target])
        selected_plan = max(
            (repo / folder / "plans").glob("*.json"), key=lambda p: p.stat().st_mtime_ns
        )
        run(
            [
                "./scripts/review-gate",
                "record",
                str(selected_plan),
                str(scan),
                str(agent),
            ]
        )
    run(["git", "push", "--dry-run", "origin", "feature"])
    run(["git", "push", "--dry-run", "origin", "release"])
    run(["git", "push", "--dry-run", "origin", "feature", "unrelated"])
    for branches in (("release", "feature"), ("feature", "release")):
        result = subprocess.run(
            ["git", "push", "--dry-run", "origin", *branches],
            cwd=repo,
            env=env,
            text=True,
            capture_output=True,
        )
        assert result.returncode != 0, result.stdout + result.stderr
        assert "PR target is updated by the same push" in result.stderr, result.stderr
        count += 1
    assert run(["git", "ls-remote", "origin", "refs/heads/release"]) == (
        baseline + "\trefs/heads/release"
    )
    assert not run(["git", "ls-remote", "origin", "refs/heads/feature"])
    receiptpath.write_bytes(feature_receipt)
    # New commit makes the old receipt stale.
    (repo / "file").write_text("changed\n")
    run(["git", "add", "."])
    run(["git", "commit", "-m", "test: changed"])
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    run(
        [
            "./scripts/review-gate",
            "record",
            "url",
            "ref",
            "old",
            "head",
            "security.json",
            "agent.json",
        ],
        False,
    )
    # main and deletion are rejected directly even without a matching receipt.
    zero = "0" * len(head)
    args = ["./.githooks/pre-push", "origin", remote_url]
    run(args, False, f"refs/heads/feature {head} refs/heads/main {baseline}\n")
    run(args, False, f"(delete) {zero} refs/heads/feature {head}\n")
    run(args, False, f"refs/heads/feature {head} refs/tags/v1 {zero}\n")
    # Parent gitlink review cannot substitute for child code review. Publish the
    # already-reviewed child commit, then validate its retained receipt.
    parent = temp / "parent"
    parent.mkdir()
    run(["git", "init", "-b", "main"], cwd=parent)
    run(["git", "config", "user.name", "Synthetic Test"], cwd=parent)
    run(["git", "config", "user.email", "test@example.invalid"], cwd=parent)
    run(
        [
            "git",
            "update-index",
            "--add",
            "--cacheinfo",
            "160000," + baseline + ",child",
        ],
        cwd=parent,
    )
    (parent / ".gitmodules").write_text(
        '[submodule "child"]\n\tpath = child\n\turl = ' + remote_url + "\n"
    )
    run(["git", "add", ".gitmodules"], cwd=parent)
    run(["git", "commit", "-m", "test: parent baseline"], cwd=parent)
    parent_base = run(["git", "rev-parse", "HEAD"], cwd=parent)
    parent_remote = temp / "parent.git"
    run(["git", "init", "--bare", str(parent_remote)], cwd=parent)
    parent_url = "file://localhost" + str(parent_remote)
    run(["git", "remote", "add", "origin", parent_url], cwd=parent)
    run(["git", "push", "origin", "main"], cwd=parent)
    run(["git", "checkout", "-b", "feature"], cwd=parent)
    run(["git", "update-index", "--cacheinfo", "160000," + head + ",child"], cwd=parent)
    run(["git", "commit", "-m", "test: child update"], cwd=parent)
    parent_head = run(["git", "rev-parse", "HEAD"], cwd=parent)
    parent_plan = {
        **plan,
        "url": parent_url,
        "head": parent_head,
        "scan_base": parent_base,
        "remote_main": parent_base,
    }
    parent_planpath = temp / "parent-plan.json"
    parent_planpath.write_text(json.dumps(parent_plan))
    parent_manifest = copy.deepcopy(manifest)
    parent_manifest["scan"]["target"].update(
        remote=parent_url, baseRevision=parent_base, headRevision=parent_head
    )
    seal(parent_manifest)
    parent_agent = temp / "parent-agent.json"
    parent_agent.write_text(
        json.dumps(
            {**agentdata, "reviewed_base": parent_base, "reviewed_head": parent_head}
        )
    )
    # Use a distinct scan directory; child evidence must remain unchanged.
    parent_scan = temp / "parent-scan"
    shutil.copytree(scan, parent_scan)
    seal()
    run(record)
    run(["git", "push", "origin", head + ":refs/heads/feature"])
    parent_record = [
        str(root / "scripts/review-gate"),
        "record",
        str(parent_planpath),
        str(parent_scan),
        str(parent_agent),
    ]
    run(parent_record, False, cwd=parent)
    child_evidence = temp / "child-evidence.json"
    child_evidence.write_text(
        json.dumps(
            {"child": {"repository": str(repo), "receipt_path": str(receiptpath)}}
        )
    )
    for configkey in ("diff.ignoreSubmodules", "submodule.child.ignore"):
        run(["git", "config", configkey, "all"], cwd=parent)
        run(parent_record, False, cwd=parent)
        run(["git", "config", "--unset", configkey], cwd=parent)
    # Consumer reachability cannot be redirected by the evidence checkout.
    rewrite_key = "url." + str(mirror) + ".insteadOf"
    run(["git", "config", rewrite_key, remote_url])
    result = subprocess.run(
        parent_record + [str(child_evidence)],
        cwd=parent,
        env=env,
        text=True,
        capture_output=True,
    )
    assert result.returncode != 0 and "URL rewrite changes" in result.stderr, (
        result.stdout,
        result.stderr,
    )
    count += 1
    run(["git", "config", "--unset", rewrite_key])
    # The committed config delimiter must preserve newline submodule paths.
    newline_parent = temp / "newline-parent"
    run(
        ["git", "clone", "--branch", "main", str(parent_remote), str(newline_parent)],
        cwd=parent,
    )
    run(["git", "config", "user.name", "Synthetic Test"], cwd=newline_parent)
    run(["git", "config", "user.email", "test@example.invalid"], cwd=newline_parent)
    run(
        ["git", "config", "-f", ".gitmodules", "submodule.child.path", "child\npath"],
        cwd=newline_parent,
    )
    run(["git", "update-index", "--force-remove", "child"], cwd=newline_parent)
    run(
        [
            "git",
            "update-index",
            "--add",
            "--cacheinfo",
            "160000," + baseline + ",child\npath",
        ],
        cwd=newline_parent,
    )
    run(["git", "add", ".gitmodules"], cwd=newline_parent)
    run(["git", "commit", "-m", "test: newline path baseline"], cwd=newline_parent)
    newline_base = run(["git", "rev-parse", "HEAD"], cwd=newline_parent)
    run(
        ["git", "update-index", "--cacheinfo", "160000," + head + ",child\npath"],
        cwd=newline_parent,
    )
    run(["git", "commit", "-m", "test: newline path update"], cwd=newline_parent)
    newline_head = run(["git", "rev-parse", "HEAD"], cwd=newline_parent)
    previous_cwd = Path.cwd()
    try:
        os.chdir(newline_parent)
        assert gate.submodule_url(newline_base, "child\npath") == remote_url
        gate.submodule_reviews(
            {"scan_base": newline_base, "head": newline_head},
            {
                "child\npath": {
                    "repository": str(repo),
                    "receipts": [
                        {"path": str(receiptpath), "sha256": gate.digest(receiptpath)}
                    ],
                }
            },
        )
    finally:
        os.chdir(previous_cwd)
    count += 1
    # A CR gitlink must not be matched to a distinct LF .gitmodules path.
    run(["git", "update-index", "--force-remove", "child\npath"], cwd=newline_parent)
    run(
        [
            "git",
            "update-index",
            "--add",
            "--cacheinfo",
            "160000," + head + ",child\rpath",
        ],
        cwd=newline_parent,
    )
    run(["git", "commit", "-m", "test: mismatched CR gitlink"], cwd=newline_parent)
    cr_head = run(["git", "rev-parse", "HEAD"], cwd=newline_parent)
    previous_cwd = Path.cwd()
    try:
        os.chdir(newline_parent)
        assert "child\rpath" in gate.gitlinks(cr_head)
        assert "child\npath" not in gate.gitlinks(cr_head)
        try:
            gate.submodule_url(cr_head, "child\rpath")
            raise AssertionError("distinct CR/LF paths matched")
        except ValueError as error:
            assert "one committed URL" in str(error)
    finally:
        os.chdir(previous_cwd)
    # Handcrafted symlink blob contents must be rejected before config parsing.
    tree_sha = run(["git", "write-tree"], cwd=newline_parent)
    raw_tree = subprocess.check_output(
        ["git", "cat-file", "tree", tree_sha], cwd=newline_parent, env=env
    )
    assert raw_tree.count(b"100644 .gitmodules\0") == 1
    crafted_tree = temp / "symlink-tree-object"
    crafted_tree.write_bytes(
        raw_tree.replace(b"100644 .gitmodules\0", b"120000 .gitmodules\0", 1)
    )
    symlink_tree = run(
        ["git", "hash-object", "--literally", "-t", "tree", "-w", str(crafted_tree)],
        cwd=newline_parent,
    )
    symlink_head = run(
        [
            "git",
            "commit-tree",
            symlink_tree,
            "-p",
            cr_head,
            "-m",
            "test: symlink gitmodules",
        ],
        cwd=newline_parent,
    )
    previous_cwd = Path.cwd()
    try:
        os.chdir(newline_parent)
        try:
            gate.submodule_url(symlink_head, "child\npath")
            raise AssertionError("symlink gitmodules accepted")
        except ValueError as error:
            assert "regular blob" in str(error)
    finally:
        os.chdir(previous_cwd)
    run(["git", "reset", "--hard", newline_head], cwd=newline_parent)
    # Quoted trailing whitespace denotes a distinct actual consumer repository.
    spaced_remote = temp / "child-space.git "
    run(["git", "clone", "--bare", str(remote), str(spaced_remote)])
    spaced_url = "file://localhost" + str(spaced_remote)
    run(
        ["git", "config", "-f", ".gitmodules", "submodule.child.url", spaced_url],
        cwd=newline_parent,
    )
    run(["git", "add", ".gitmodules"], cwd=newline_parent)
    run(["git", "commit", "-m", "test: preserve URL whitespace"], cwd=newline_parent)
    spaced_head = run(["git", "rev-parse", "HEAD"], cwd=newline_parent)
    previous_cwd = Path.cwd()
    try:
        os.chdir(newline_parent)
        assert gate.submodule_url(spaced_head, "child\npath") == spaced_url
        assert gate.expanded_destination(spaced_url) == spaced_url
        assert gate.repository_location(spaced_url) != gate.repository_location(
            remote_url
        )
    finally:
        os.chdir(previous_cwd)
    count += 3
    # A fork receipt cannot authorize a consumer URL where the SHA is absent.
    child_receipt = json.loads(receiptpath.read_text())
    original_child_receipt = receiptpath.read_bytes()
    child_receipt["plan"]["url"] = "file://localhost" + str(mirror)
    receiptpath.write_text(json.dumps(child_receipt))
    run(parent_record + [str(child_evidence)], False, cwd=parent)
    receiptpath.write_bytes(original_child_receipt)
    run(parent_record + [str(child_evidence)], cwd=parent)
    parent_receipt = (
        parent / ".git/push-reviews" / (gate.identity(parent_plan) + ".json")
    )
    verify_parent = [
        str(root / "scripts/review-gate"),
        "verify-submodule",
        str(parent_receipt),
        parent_base,
        parent_head,
    ]
    # Parent itself is not published, even though all code evidence exists.
    run(verify_parent, False, cwd=parent)
    # Exact gitlink moves preserve the existing child baseline without new review.
    mover = temp / "mover"
    run(["git", "clone", str(parent_remote), str(mover)], cwd=parent)
    run(["git", "config", "user.name", "Synthetic Test"], cwd=mover)
    run(["git", "config", "user.email", "test@example.invalid"], cwd=mover)
    run(["git", "update-index", "--force-remove", "child"], cwd=mover)
    run(
        [
            "git",
            "update-index",
            "--add",
            "--cacheinfo",
            "160000," + baseline + ",moved",
        ],
        cwd=mover,
    )
    (mover / ".gitmodules").write_text(
        '[submodule "child"]\n\tpath = moved\n\turl = ' + remote_url + "\n"
    )
    run(["git", "add", ".gitmodules"], cwd=mover)
    run(["git", "commit", "-m", "test: exact move"], cwd=mover)
    moved_head = run(["git", "rev-parse", "HEAD"], cwd=mover)
    saved_cwd = Path.cwd()
    try:
        os.chdir(mover)
        assert (
            gate.changed_gitlinks({"scan_base": parent_base, "head": moved_head}) == {}
        )
    finally:
        os.chdir(saved_cwd)
    # Metadata-only consumer URL switches are rejected with unchanged gitlinks.
    # Reset only this disposable fixture clone to its committed baseline.
    run(["git", "reset", "--hard", parent_base], cwd=mover)
    (mover / ".gitmodules").write_text(
        '[submodule "child"]\n\tpath = child\n\turl = '
        + "file://localhost"
        + str(mirror)
        + "\n"
    )
    run(["git", "add", ".gitmodules"], cwd=mover)
    run(["git", "commit", "-m", "test: URL-only switch"], cwd=mover)
    metadata_head = run(["git", "rev-parse", "HEAD"], cwd=mover)
    try:
        os.chdir(mover)
        try:
            gate.changed_gitlinks({"scan_base": parent_base, "head": metadata_head})
            raise AssertionError("metadata-only URL switch bypassed evidence")
        except ValueError as error:
            assert "unchanged submodule URL change" in str(error)
    finally:
        os.chdir(saved_cwd)
    # Child evidence tampering is caught again at parent push time.
    shutil.copytree(root / ".githooks", parent / ".githooks")
    (parent / "scripts").mkdir()
    shutil.copy2(root / "scripts/review-gate", parent / "scripts/review-gate")
    run(["git", "config", "core.hooksPath", ".githooks"], cwd=parent)
    run(["git", "push", "--dry-run", "origin", "feature"], cwd=parent)
    child_receipt_bytes = receiptpath.read_bytes()
    receiptpath.write_text("{}")
    run(["git", "push", "--dry-run", "origin", "feature"], False, cwd=parent)
    receiptpath.write_bytes(child_receipt_bytes)
    run(["git", "push", "--dry-run", "origin", "feature"], cwd=parent)
    # Publish the next child commit with cumulative A->C review evidence.
    next_head = run(["git", "rev-parse", "HEAD"])
    run(["./scripts/prepare-push", "origin", "feature"])
    next_planpath = max(
        (repo / folder / "plans").glob("*.json"), key=lambda p: p.stat().st_mtime_ns
    )
    next_plan = json.loads(next_planpath.read_text())
    assert next_plan["scan_base"] == baseline and next_plan["head"] == next_head
    assert next_plan["remote_old"] == head
    old_scan = scan
    scan = temp / "next-child-scan"
    scan.mkdir()
    next_manifest = copy.deepcopy(manifest)
    next_manifest["scan"]["target"].update(
        baseRevision=baseline, headRevision=next_head
    )
    seal(next_manifest)
    next_agent = temp / "next-agent.json"
    next_agent.write_text(
        json.dumps({**agentdata, "reviewed_base": baseline, "reviewed_head": next_head})
    )
    run(
        [
            "./scripts/review-gate",
            "record",
            str(next_planpath),
            str(scan),
            str(next_agent),
        ]
    )
    # A validly sealed scan of only the latest push cannot satisfy the PR gate.
    narrowed_manifest = copy.deepcopy(next_manifest)
    narrowed_manifest["scan"]["target"]["baseRevision"] = head
    seal(narrowed_manifest)
    run(
        [
            "./scripts/review-gate",
            "record",
            str(next_planpath),
            str(scan),
            str(next_agent),
        ],
        False,
    )
    seal(next_manifest)
    # Target movement invalidates an existing branch's receipt at actual push.
    run(["git", "--git-dir", str(remote), "update-ref", "refs/heads/main", head])
    run(["git", "push", "--dry-run", "origin", "feature"], False)
    run(["git", "--git-dir", str(remote), "update-ref", "refs/heads/main", baseline])
    cumulative_agent = next_agent.read_bytes()
    next_agent.write_text(
        json.dumps({**agentdata, "reviewed_base": head, "reviewed_head": next_head})
    )
    run(
        [
            "./scripts/review-gate",
            "record",
            str(next_planpath),
            str(scan),
            str(next_agent),
        ],
        False,
    )
    next_agent.write_bytes(cumulative_agent)
    next_receipt = repo / folder / (gate.identity(next_plan) + ".json")
    run(["git", "push", "origin", "feature"])
    scan = old_scan
    run(
        ["git", "update-index", "--cacheinfo", "160000," + next_head + ",child"],
        cwd=parent,
    )
    tree = run(["git", "write-tree"], cwd=parent)
    chain_parent_head = run(
        [
            "git",
            "commit-tree",
            tree,
            "-p",
            parent_base,
            "-m",
            "test: batched child update",
        ],
        cwd=parent,
    )
    run(["git", "update-ref", "refs/heads/feature", chain_parent_head], cwd=parent)
    chain_plan = {**parent_plan, "head": chain_parent_head}
    chain_planpath = temp / "chain-plan.json"
    chain_planpath.write_text(json.dumps(chain_plan))
    scan = temp / "chain-parent-scan"
    scan.mkdir()
    chain_manifest = copy.deepcopy(parent_manifest)
    chain_manifest["scan"]["target"]["headRevision"] = chain_parent_head
    seal(chain_manifest)
    chain_agent = temp / "chain-agent.json"
    chain_agent.write_text(
        json.dumps(
            {
                **agentdata,
                "reviewed_base": parent_base,
                "reviewed_head": chain_parent_head,
            }
        )
    )
    chain_record = [
        str(root / "scripts/review-gate"),
        "record",
        str(chain_planpath),
        str(scan),
        str(chain_agent),
        str(child_evidence),
    ]
    run(chain_record, False, cwd=parent)  # A->B alone cannot attest A->C.
    for chain, success in (
        ([next_receipt, receiptpath], False),
        ([receiptpath, next_receipt], False),
        ([next_receipt], True),
    ):
        child_evidence.write_text(
            json.dumps(
                {
                    "child": {
                        "repository": str(repo),
                        "receipt_paths": [str(p) for p in chain],
                    }
                }
            )
        )
        run(chain_record, success, cwd=parent)
    run(["git", "push", "--dry-run", "origin", "feature"], cwd=parent)
    # Another clone advances to a descendant absent from the evidence repository.
    outsider = temp / "outsider"
    run(["git", "clone", "--branch", "feature", str(remote), str(outsider)])
    run(["git", "config", "user.name", "Synthetic Test"], cwd=outsider)
    run(["git", "config", "user.email", "test@example.invalid"], cwd=outsider)
    run(
        ["git", "commit", "--allow-empty", "-m", "test: unseen remote descendant"],
        cwd=outsider,
    )
    tip = run(["git", "rev-parse", "HEAD"], cwd=outsider)
    run(["git", "push", "origin", "feature"], cwd=outsider)
    run(
        ["git", "commit", "--allow-empty", "-m", "test: unrelated descendant"],
        cwd=outsider,
    )
    irrelevant_tip = run(["git", "rev-parse", "HEAD"], cwd=outsider)
    run(["git", "push", "origin", "HEAD:refs/heads/unrelated"], cwd=outsider)
    run(["git", "cat-file", "-e", tip + "^{commit}"], False)
    branch_before = run(["git", "rev-parse", "HEAD"])
    run(chain_record, cwd=parent)
    assert run(["git", "rev-parse", "HEAD"]) == branch_before
    run(["git", "cat-file", "-e", tip + "^{commit}"])
    run(["git", "cat-file", "-e", irrelevant_tip + "^{commit}"], False)
print(
    "PASS:",
    count,
    "synthetic integration assertions; no hosted review or real remote push",
)
