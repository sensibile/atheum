#!/usr/bin/env python3
"""Push planning and sealed Codex Security evidence gate. No model calls or push."""

import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import unquote, urlsplit


def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def load(path):
    return json.loads(Path(path).read_text())


def store():
    return Path(git("rev-parse", "--git-common-dir")).resolve() / "push-reviews"


def identity(plan):
    values = [plan[k] for k in ("url", "ref", "remote_old", "head")]
    return hashlib.sha256(json.dumps(values).encode()).hexdigest()


def require(condition, message):
    if not condition:
        raise ValueError(message)


def revision(sha):
    require(bool(re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", sha)), "full SHA required")
    require(git("rev-parse", "--verify", sha + "^{commit}") == sha, "not a commit")


def plugin():
    configured = os.environ.get("CODEX_SECURITY_PLUGIN_DIR")
    if not configured:
        result = subprocess.run(
            ["git", "config", "--get", "codex.securityPluginDir"],
            capture_output=True,
            text=True,
        )
        configured = result.stdout.strip()
    if configured:
        candidates = [Path(configured).expanduser()]
    else:
        home = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
        candidates = sorted(
            (home / "plugins/cache/openai-curated-remote/codex-security").glob(
                "*/scripts/validate_scan_contract.py"
            ),
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
        candidates = [p.parent.parent for p in candidates]
    require(
        bool(candidates),
        "Codex Security validator unavailable; set codex.securityPluginDir",
    )
    validator = candidates[0] / "scripts/validate_scan_contract.py"
    require(validator.is_file(), "Codex Security validator missing")
    return validator


def agent_review(path, plan):
    data = load(path)
    require(
        data.get("kind") == "agent"
        and data.get("verdict") == "pass"
        and data.get("independent") is True
        and data.get("blocking_findings") == []
        and data.get("reviewed_base") == plan["scan_base"]
        and data.get("reviewed_head") == plan["head"]
        and bool(data.get("reviewer"))
        and bool(data.get("summary")),
        "independent review missing, failed or out of range",
    )


def repository_location(remote):
    """Preserve transport/port/path semantics; normalize GitHub and local aliases."""
    safe_push_url(remote)
    if Path(remote).is_absolute():
        return "local", str(Path(remote).resolve())
    if remote.startswith("file:"):
        parsed = urlsplit(remote)
        return "local", str(Path(unquote(parsed.path)).resolve())
    if "://" in remote:
        parsed = urlsplit(remote)
        scheme, host, user, path = (
            parsed.scheme,
            parsed.hostname,
            parsed.username,
            parsed.path,
        )
        port = parsed.port or {"http": 80, "https": 443, "ssh": 22, "git": 9418}.get(
            scheme
        )
    else:
        match = re.fullmatch(
            r"(?:(?P<user>[^@]+)@)?(?P<host>[^:]+):(?P<path>.+)", remote
        )
        require(match is not None, "unrecognized declared repository location")
        scheme, host, user, path, port = (
            "ssh",
            match["host"],
            match["user"],
            match["path"],
            22,
        )
    require(bool(host) and bool(path), "invalid declared repository location")
    # GitHub uses the same repository namespace for its documented HTTPS and
    # git-user SSH transports. Other servers may map them to different roots.
    if host.lower() == "github.com" and (
        (scheme == "https" and port == 443)
        or (scheme == "ssh" and port == 22 and user in (None, "git"))
    ):
        return "github.com", path.strip("/").removesuffix(".git")
    return scheme, host.lower(), port, user, path


def gitlinks(revision):
    result = {}
    for entry in git("ls-tree", "-r", "-z", revision).split("\0"):
        if entry:
            metadata, path = entry.split("\t", 1)
            mode, kind, sha = metadata.split()
            if mode == "160000":
                result[path] = sha
    return result


def endpoint_range(plan):
    # Endpoint scans cannot account for content introduced then removed in history.
    commits = git("rev-list", plan["scan_base"] + ".." + plan["head"]).splitlines()
    require(
        len(commits) == 1 and commits[0] == plan["head"],
        "endpoint reviews require exactly one new commit; prepare each commit separately",
    )
    require(
        git("show", "-s", "--format=%P", plan["head"]) == plan["scan_base"],
        "endpoint reviews require a linear single-commit update",
    )


def security_review(directory, plan):
    directory = Path(directory).resolve(strict=True)
    subprocess.run(
        [sys.executable, str(plugin()), "--scan-dir", str(directory)],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    manifest = load(directory / "scan-manifest.json")
    scan = manifest["scan"]
    target = scan["target"]
    require(
        scan["status"] == "completed" and bool(scan["sealedAt"]),
        "scan is not completed and sealed",
    )
    require(
        scan["producer"]["name"] == "codex-security-plugin", "unexpected scan producer"
    )
    require(
        target["kind"] == "git_diff"
        and target["baseRevision"] == plan["scan_base"]
        and target["headRevision"] == plan["head"],
        "security scan range mismatch",
    )
    # Desktop producer may omit optional remote. Exact full base/head hashes
    # bind the reviewed Git objects; receipt independently binds push destination.
    if target.get("remote"):
        require(
            repository_location(target["remote"]) == repository_location(plan["url"]),
            "security repository mismatch",
        )
    coverage = load(directory / scan["coverageRef"])
    findings = load(directory / scan["findingsRef"])
    require(
        coverage["completeness"] == "complete"
        and not coverage["deferred"]
        and not coverage["explicitExclusions"]
        and not coverage["excludePaths"]
        and coverage["includePaths"] == ["."]
        and coverage["mode"] in ("diff", "commit", "branch_diff")
        and not any(
            s["disposition"] in ("needs_follow_up", "reported")
            for s in coverage["surfaces"]
        ),
        "incomplete or narrowed security coverage",
    )
    require(not findings["findings"], "security findings block push; fix and rescan")
    return {
        "directory": str(directory),
        "manifest_sha256": digest(directory / "scan-manifest.json"),
    }


def safe_push_url(url):
    # Repository-controlled URLs must not select arbitrary Git remote helpers.
    if not Path(url).is_absolute():
        require(not re.match(r"^[^/:]+::", url), "remote-helper URL is forbidden")
    # Credentials belong in a credential helper, never in persisted evidence.
    if "://" in url:
        parsed = urlsplit(url)
        require(
            parsed.scheme in ("file", "http", "https", "ssh", "git"),
            "unsupported push URL transport",
        )
        require(
            not parsed.password,
            "push URL credentials are forbidden; use a credential helper",
        )
        require(
            "?" not in url and "#" not in url,
            "push URL query or fragment is unsupported",
        )
        if parsed.scheme in ("http", "https"):
            require(
                parsed.username is None and not parsed.query and not parsed.fragment,
                "HTTP push URL must not contain userinfo, query or fragment",
            )
    if url.startswith("file:"):
        parsed = urlsplit(url)
        require(
            parsed.netloc in ("", "localhost") and Path(parsed.path).is_absolute(),
            "file push URL must name an absolute local path",
        )
    elif "://" not in url:
        require(
            Path(url).is_absolute() or re.fullmatch(r"(?:[^/@:]+@)?[^/:]+:.+", url),
            "relative local push URL is forbidden; use an absolute destination",
        )
    return url


def ordinary_objects():
    # Replacements/grafts alter inspection, but are not the objects Git transfers.
    require(
        not git("for-each-ref", "--format=%(refname)", "refs/replace/"),
        "Git replacement objects are forbidden; remove them before review",
    )
    grafts = Path(git("rev-parse", "--git-path", "info/grafts"))
    require(
        not grafts.exists() or not grafts.read_text().strip(),
        "Git grafts are forbidden; remove them before review",
    )
    require(
        not os.environ.get("GIT_REPLACE_REF_BASE"),
        "custom Git replacement namespace is forbidden",
    )


def push_destination(remote, url):
    safe_push_url(url)
    if remote in git("remote").splitlines():
        urls = git("remote", "get-url", "--push", "--all", remote).splitlines()
        require(len(urls) == 1, "one push URL required at push time")
        require(urls[0] == url, "push destination changed since preparation")
    else:
        require(remote == url, "unknown push remote")


def submodule_url(revision, path):
    result = subprocess.run(
        [
            "git",
            "config",
            "--blob",
            revision + ":.gitmodules",
            "--get-regexp",
            r"^submodule\..*\.path$",
        ],
        capture_output=True,
        text=True,
    )
    require(result.returncode == 0, "submodule path missing from committed .gitmodules")
    keys = [
        line.split(None, 1)[0]
        for line in result.stdout.splitlines()
        if len(line.split(None, 1)) == 2 and line.split(None, 1)[1] == path
    ]
    require(len(keys) == 1, "submodule path must have one committed URL")
    url = git(
        "config", "--blob", revision + ":.gitmodules", "--get", keys[0][:-4] + "url"
    )
    safe_push_url(url)  # Relative URLs need a separately specified resolution contract.
    return url


def changed_gitlinks(plan):
    before, after = gitlinks(plan["scan_base"]), gitlinks(plan["head"])
    # .gitmodules changes alone do not appear as raw gitlink records.
    for path in before.keys() & after.keys():
        if before[path] == after[path]:
            require(
                repository_location(submodule_url(plan["scan_base"], path))
                == repository_location(submodule_url(plan["head"], path)),
                "unchanged submodule URL change needs explicit reachability evidence; unsupported",
            )
    parts = git(
        "diff",
        "--raw",
        "--no-abbrev",
        "-z",
        "--no-renames",
        "--ignore-submodules=none",
        plan["scan_base"],
        plan["head"],
    ).split("\0")
    changes = [(parts[i].split(), parts[i + 1]) for i in range(0, len(parts) - 1, 2)]
    deleted = {}
    for (oldmode, newmode, old, new, status), path in changes:
        if oldmode == ":160000" and newmode == "000000":
            deleted.setdefault(old, []).append(path)
    links = {}
    for (oldmode, newmode, old, new, status), path in changes:
        if newmode != "160000":
            continue
        oldpath = path
        if oldmode != ":160000":
            matches = deleted.get(new, [])
            require(
                len(matches) == 1,
                "new submodule needs an explicit initial security baseline; unsupported",
            )
            oldpath = matches.pop()
            old = new  # An exact gitlink move introduces no child commit.
        previous = submodule_url(plan["scan_base"], oldpath)
        consumer = submodule_url(plan["head"], path)
        if old == new:
            require(
                repository_location(previous) == repository_location(consumer),
                "unchanged submodule URL change needs explicit reachability evidence; unsupported",
            )
            continue
        links[path] = (old, new, consumer)
    return links


def submodule_reviews(plan, evidence):
    links = changed_gitlinks(plan)
    require(
        set(evidence) == set(links),
        "changed submodules require separate registered review evidence",
    )
    env = os.environ.copy()
    for key in git("rev-parse", "--local-env-vars").splitlines():
        env.pop(key, None)
    for path, (base, head, consumer) in links.items():
        item = evidence[path]
        entries = item.get("receipts") or [
            {"path": item["receipt_path"], "sha256": item["receipt_sha256"]}
        ]
        repository = Path(item["repository"]).resolve(strict=True)
        cursor = base
        for entry in entries:
            receipt = Path(entry["path"]).resolve(strict=True)
            require(digest(receipt) == entry["sha256"], "submodule receipt changed")
            child = load(receipt)["plan"]
            require(
                child["scan_base"] == cursor,
                "submodule receipt chain is not contiguous",
            )
            cursor = child["head"]
            subprocess.run(
                [
                    sys.executable,
                    str(Path(__file__).resolve()),
                    "verify-submodule",
                    str(receipt),
                    child["scan_base"],
                    cursor,
                    consumer,
                ],
                cwd=repository,
                env=env,
                check=True,
                stdout=subprocess.DEVNULL,
            )
        require(cursor == head, "submodule receipt chain does not reach new gitlink")


def advertised_refs(url, ref):
    safe_push_url(url)
    return dict(
        line.split()[::-1]
        for line in git("ls-remote", url, ref, "refs/heads/main").splitlines()
    )


def validate_plan(plan):
    ordinary_objects()
    require(plan.get("version") == 2, "unsupported push plan")
    require(
        plan["ref"].startswith("refs/heads/") and plan["ref"] != "refs/heads/main",
        "use a feature branch and PR",
    )
    safe_push_url(plan["url"])
    revision(plan["head"])
    revision(plan["scan_base"])
    if set(plan["remote_old"]) != {"0"}:
        require(
            plan["scan_base"] == plan["remote_old"], "existing branch base mismatch"
        )
        revision(plan["remote_old"])
    else:
        refs = advertised_refs(plan["url"], plan["ref"])
        require(
            refs.get(plan["ref"], "0" * len(plan["head"])) == plan["remote_old"],
            "destination branch changed; prepare and review again",
        )
        require(
            refs.get("refs/heads/main") == plan["remote_main"],
            "remote main baseline changed or forged; prepare and review again",
        )
        revision(plan["remote_main"])
        require(
            git("merge-base", plan["remote_main"], plan["head"]) == plan["scan_base"],
            "new branch baseline mismatch",
        )

    endpoint_range(plan)


def check_record(record, delivered=False):
    plan = record["plan"]
    endpoint_range(plan)
    if delivered:
        # A child's successful push changes the destination ref; retain its
        # exact reviewed range while verifying remote reachability separately.
        ordinary_objects()
        revision(plan["head"])
        revision(plan["scan_base"])
    else:
        validate_plan(plan)
    security = security_review(record["security"]["directory"], plan)
    require(
        security == record["security"], "security evidence changed since registration"
    )
    path = record["agent"]["path"]
    require(
        digest(path) == record["agent"]["sha256"],
        "agent evidence changed since registration",
    )
    agent_review(path, plan)
    submodule_reviews(plan, record.get("submodules", {}))


def main():
    mode = sys.argv[1]
    if mode == "prepare":
        ordinary_objects()
        remote = sys.argv[2] if len(sys.argv) > 2 else "origin"
        branch = sys.argv[3] if len(sys.argv) > 3 else git("branch", "--show-current")
        require(branch and branch != "main", "use a feature branch and PR")
        subprocess.run(
            ["git", "check-ref-format", "--branch", branch],
            check=True,
            stdout=subprocess.DEVNULL,
        )
        require(
            not git("status", "--porcelain"),
            "commit intended changes before preparing push",
        )
        ref = "refs/heads/" + branch
        head = git("rev-parse", ref + "^{commit}")
        url = git("remote", "get-url", "--push", "--all", remote)
        require(len(url.splitlines()) == 1, "one push URL required")
        refs = advertised_refs(url, ref)
        old = refs.get(ref, "0" * len(head))
        plan = {"version": 2, "url": url, "ref": ref, "remote_old": old, "head": head}
        if set(old) == {"0"}:
            main_sha = refs.get("refs/heads/main")
            require(
                main_sha is not None,
                "new branch needs an existing remote main baseline",
            )
            revision(
                main_sha
            )  # fetch if the advertised commit is not locally available
            plan["remote_main"] = main_sha
            plan["scan_base"] = git("merge-base", main_sha, head)
        else:
            plan["scan_base"] = old
        validate_plan(plan)
        folder = store() / "plans"
        folder.mkdir(parents=True, exist_ok=True)
        path = folder / (identity(plan) + ".json")
        path.write_text(json.dumps(plan, indent=2) + "\n")
        print("Push plan:", path)
        print(
            "Codex: run $codex-security:security-diff-scan on the unchanged range",
            plan["scan_base"],
            "..",
            head,
        )
        print(
            "Then run an independent review on the same range. Do not edit, commit or push during either review."
        )
        print(
            "Register: ./scripts/review-gate record",
            path,
            "COMPLETED_SCAN_DIR AGENT_JSON",
        )
        print("No scan, model call or push was executed.")
    elif mode == "record":
        require(
            len(sys.argv) in (5, 6),
            "record PLAN_JSON COMPLETED_SCAN_DIR AGENT_JSON [SUBMODULE_JSON]; manual security pass is not accepted",
        )
        plan = load(sys.argv[2])
        validate_plan(plan)
        security = security_review(sys.argv[3], plan)
        path = Path(sys.argv[4]).resolve(strict=True)
        agent_review(path, plan)
        record = {
            "plan": plan,
            "security": security,
            "agent": {"path": str(path), "sha256": digest(path)},
        }
        evidence = load(sys.argv[5]) if len(sys.argv) == 6 else {}
        record["submodules"] = {}
        for name, item in evidence.items():
            paths = item.get("receipt_paths")
            if paths is None:
                paths = [item["receipt_path"]]
            require(
                isinstance(paths, list) and bool(paths),
                "submodule receipt chain must not be empty",
            )
            record["submodules"][name] = {
                "repository": str(Path(item["repository"]).resolve(strict=True)),
                "receipts": [
                    {
                        "path": str(Path(path).resolve(strict=True)),
                        "sha256": digest(path),
                    }
                    for path in paths
                ],
            }
        submodule_reviews(plan, record["submodules"])
        folder = store()
        folder.mkdir(parents=True, exist_ok=True)
        target = folder / (identity(plan) + ".json")
        target.write_text(json.dumps(record, indent=2) + "\n")
        print("Registered sealed scan and independent review:", target)
    elif mode == "push":
        ordinary_objects()
        url = safe_push_url(sys.argv[3])
        push_destination(sys.argv[2], url)
        for line in sys.stdin:
            local_ref, head, ref, old = line.split()
            require(set(head) != {"0"}, "ref deletion is blocked")
            require(
                ref.startswith("refs/heads/") and ref != "refs/heads/main",
                "only feature branches; main requires a PR",
            )
            key = identity({"url": url, "ref": ref, "remote_old": old, "head": head})
            record = load(store() / (key + ".json"))
            require(
                {k: record["plan"][k] for k in ("url", "ref", "remote_old", "head")}
                == {"url": url, "ref": ref, "remote_old": old, "head": head},
                "push plan mismatch",
            )
            check_record(record)
        print("pre-push: sealed Codex Security and independent review verified")
    elif mode == "verify-submodule":
        require(
            len(sys.argv) in (5, 6), "verify-submodule RECEIPT BASE HEAD [CONSUMER_URL]"
        )
        record = load(sys.argv[2])
        require(
            record["plan"]["scan_base"] == sys.argv[3]
            and record["plan"]["head"] == sys.argv[4],
            "submodule review range mismatch",
        )
        check_record(record, delivered=True)
        consumer = sys.argv[5] if len(sys.argv) == 6 else record["plan"]["url"]
        require(
            repository_location(record["plan"]["url"]) == repository_location(consumer),
            "submodule receipt destination differs from committed consumer URL",
        )
        refs = dict(
            line.split()[::-1]
            for line in git(
                "ls-remote", consumer, "refs/heads/*", "refs/tags/*"
            ).splitlines()
        )
        # Prefer the reviewed destination, then stop at the first proven ancestor.
        tips = list(
            dict.fromkeys(
                [refs[record["plan"]["ref"]]] if record["plan"]["ref"] in refs else []
            )
        )
        tips += [tip for tip in dict.fromkeys(refs.values()) if tip not in tips]
        reachable = False
        for tip in tips:
            if subprocess.run(
                ["git", "cat-file", "-e", tip + "^{commit}"], capture_output=True
            ).returncode:
                fetched = subprocess.run(
                    [
                        "git",
                        "fetch",
                        "--no-tags",
                        "--no-write-fetch-head",
                        consumer,
                        tip,
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                if fetched.returncode:
                    continue
            if (
                subprocess.run(
                    ["git", "merge-base", "--is-ancestor", sys.argv[4], tip],
                    capture_output=True,
                ).returncode
                == 0
            ):
                reachable = True
                break
        require(
            reachable,
            "submodule reachability could not be verified from advertised remote refs",
        )

    else:
        raise ValueError(
            "usage: review-gate prepare [REMOTE BRANCH] | record PLAN SCAN_DIR AGENT_JSON | push REMOTE URL"
        )


if __name__ == "__main__":
    try:
        main()
    except (
        ValueError,
        OSError,
        KeyError,
        IndexError,
        TypeError,
        subprocess.CalledProcessError,
    ) as error:
        message = (
            "Git or validator command failed"
            if isinstance(error, subprocess.CalledProcessError)
            else str(error)
        )
        print("BLOCKED: push gate:", message, file=sys.stderr)
        sys.exit(1)
